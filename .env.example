# =============================================================================
# AI-Based Career Recommendation System - Environment Configuration
# =============================================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=production
# Set stable, randomly generated values in your private .env or hosting settings.
SECRET_KEY=
AUTH_SECRET_PEPPER=
APP_BASE_URL=http://localhost:5000

# Database Configuration (MySQL / SQLite)
# To use MySQL, set DATABASE_TYPE=mysql and provide MySQL credentials below.
# If DATABASE_TYPE=sqlite or MySQL credentials are not provided, falls back to SQLite.
DATABASE_TYPE=sqlite
CLOUD_SQL_CONNECTION_NAME=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=career_app

# Configure one sender account for the app. Registrants only enter their own email;
# OTP messages are sent to that address by this sender.
# For Gmail: host=smtp.gmail.com, port=587, use_tls=true, user=your_email, password=app_password
# Enable 2-Step Verification for the sender Gmail and create a Google App Password.
# Never ask registrants for their Gmail password or App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Use the same Gmail as SMTP_USER unless this account has a verified sending alias.
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Career Recommendation System Team

# Set to true only in automated tests that intentionally suppress actual delivery.
MAIL_SUPPRESS_SEND=false
